# Challenge LoL — API Riot Games
# Copiez ce fichier en ".env" (a cote de OverlayTwitch.exe, ou a la racine du
# projet en dev) et renseignez vos propres valeurs. Sans ce fichier, les deux
# widgets "Challenge LoL" restent inactifs mais le reste de l'overlay
# fonctionne normalement.

# Cle API Riot (portail https://developer.riotgames.com/)
# - Cle de developpement : gratuite et immediate, mais expire toutes les 24h
#   (il faut la regenerer sur le portail et remettre a jour cette ligne).
# - Cle personnelle : ne expire pas, mais necessite une demande d'approbation
#   aupres de Riot (~2 semaines).
RIOT_API_KEY=

# Compte a suivre pour le challenge (Riot ID sans le "#")
RIOT_GAME_NAME=
RIOT_TAG_LINE=

# Serveur du compte : euw1, na1, eun1, kr, jp1, oc1, br1, la1, la2, tr1, ru
RIOT_PLATFORM=euw1
